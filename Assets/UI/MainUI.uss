/* Full-screen template wrappers. picking-mode ignore so empty panel space
   falls through to the 3D view; children that need clicks keep Position. */
.screen-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ui-scale-bar {
    position: absolute;
    top: 14px;
    right: 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(22, 25, 30, 0.85);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
}

.ui-scene-btn {
    height: 22px;
    margin-left: 0;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(230, 230, 230);
    font-size: 11px;
    white-space: nowrap;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ui-scene-btn:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.ui-scene-btn:disabled {
    color: rgb(110, 114, 120);
    background-color: rgba(255, 255, 255, 0.04);
}

.ui-scale-sep {
    width: 1px;
    height: 14px;
    margin-left: 0;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
}

.ui-scene-btn.scene-state-toggle--open {
    background-color: rgba(65, 140, 245, 0.4);
}

.ui-scale-btn {
    width: 22px;
    height: 22px;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(230, 230, 230);
    font-size: 14px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ui-scale-btn:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.ui-scale-label {
    color: rgb(220, 220, 220);
    font-size: 11px;
    width: 40px;
    -unity-text-align: middle-center;
}

.float-grip {
    position: absolute;
    background-color: rgba(0, 0, 0, 0);
}

.float-grip--n {
    left: 8px;
    right: 8px;
    top: 0;
    height: 7px;
}

.float-grip--s {
    left: 8px;
    right: 8px;
    bottom: 0;
    height: 7px;
}

.float-grip--e {
    top: 8px;
    bottom: 8px;
    right: 0;
    width: 7px;
}

.float-grip--w {
    top: 8px;
    bottom: 8px;
    left: 0;
    width: 7px;
}

.float-grip--ne {
    top: 0;
    right: 0;
    width: 10px;
    height: 10px;
}

.float-grip--nw {
    top: 0;
    left: 0;
    width: 10px;
    height: 10px;
}

.float-grip--se {
    bottom: 0;
    right: 0;
    width: 10px;
    height: 10px;
}

.float-grip--sw {
    bottom: 0;
    left: 0;
    width: 10px;
    height: 10px;
}
