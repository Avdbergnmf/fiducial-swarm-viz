    <ui:VisualElement name="uiScaleBar" picking-mode="Position" class="ui-scale-bar">
        <ui:Button name="aircraftOpenBtn" text="Aircraft" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="sceneStateOpenBtn" text="Events" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="logsOpenBtn" text="Logs" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="uiScaleDownBtn" text="-" picking-mode="Position" class="ui-scale-btn" />
        <ui:Label name="uiScaleLabel" text="125%" picking-mode="Ignore" class="ui-scale-label" />
        <ui:Button name="uiScaleUpBtn" text="+" picking-mode="Position" class="ui-scale-btn" />
    </ui:VisualElement>
