<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="RunPicker" src="project://database/Assets/Scripts/UI/RunPicker/RunPickerView.uxml?fileID=9197481963319205126&amp;guid=9b008acec54777243b646306bce242dc&amp;type=3#RunPickerView"/>
    <ui:Template name="Timeline" src="project://database/Assets/Scripts/UI/Timeline/TimelineView.uxml?fileID=9197481963319205126&amp;guid=7abf47447fe8d5449b641403b67f185d&amp;type=3#TimelineView"/>
    <ui:Template name="EntityInspector" src="project://database/Assets/Scripts/UI/EntityInspector/EntityInspectorView.uxml?fileID=9197481963319205126&amp;guid=a7c2e9f14b5d4830ae6c1d8f2b4e7093&amp;type=3#EntityInspectorView"/>
    <ui:Template name="SceneState" src="project://database/Assets/Scripts/UI/SceneState/SceneStateView.uxml?fileID=9197481963319205126&amp;guid=c4010a8ec38487342b739e898b54ad35&amp;type=3#SceneStateView"/>
    <Style src="project://database/Assets/UI/MainUI.uss?fileID=7433441132597879392&amp;guid=98e2338bc91864847b2a69925e32154a&amp;type=3#MainUI"/>
    <Style src="project://database/Assets/Scripts/UI/SceneState/SceneStateView.uss?fileID=7433441132597879392&amp;guid=6fda26c9b79c02341a1541a7a3e8325a&amp;type=3#SceneStateView"/>
    <ui:Instance template="SceneState" name="sceneStateInstance" picking-mode="Ignore" class="screen-overlay"/>
    <ui:Instance template="EntityInspector" name="entityInspectorInstance" picking-mode="Ignore" class="screen-overlay"/>
    <ui:Instance template="RunPicker" name="runPickerInstance" picking-mode="Ignore" class="screen-overlay"/>
    <ui:VisualElement name="uiScaleBar" picking-mode="Position" class="ui-scale-bar">
        <ui:Button name="selBackBtn" text="Prev" picking-mode="Position" class="ui-scene-btn" tooltip="Previous selection" />
        <ui:Button name="selFwdBtn" text="Next" picking-mode="Position" class="ui-scene-btn" tooltip="Next selection" />
        <ui:VisualElement picking-mode="Ignore" class="ui-scale-sep" />
        <ui:Button name="aircraftOpenBtn" text="Aircraft" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="sceneStateOpenBtn" text="Events" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="scoreOpenBtn" text="Score" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="logsOpenBtn" text="Logs" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="disagreeOpenBtn" text="Disagree" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="cuesOpenBtn" text="Cues" picking-mode="Position" class="ui-scene-btn" />
        <ui:Button name="uiScaleDownBtn" text="-" picking-mode="Position" class="ui-scale-btn ui-btn-ghost" />
        <ui:Label name="uiScaleLabel" text="125%" picking-mode="Ignore" class="ui-scale-label" />
        <ui:Button name="uiScaleUpBtn" text="+" picking-mode="Position" class="ui-scale-btn ui-btn-ghost" />
    </ui:VisualElement>
    <ui:VisualElement name="legendRoot" picking-mode="Position" class="legend">
        <ui:VisualElement name="legendHeader" class="legend-header">
            <ui:Label name="legendMode" text="Ground truth" picking-mode="Ignore" class="legend-mode" />
            <ui:Button name="legendToggleBtn" text="–" picking-mode="Position" class="legend-toggle ui-btn-ghost" tooltip="Hide the colour key. ? also toggles." />
        </ui:VisualElement>
        <ui:Label name="legendSentence" text="Bodies are what they actually are." picking-mode="Ignore" class="legend-sentence" />
        <ui:VisualElement name="legendBody" class="legend-body" picking-mode="Ignore">
            <ui:VisualElement class="legend-section-head" picking-mode="Ignore">
                <ui:Label text="Craft" picking-mode="Ignore" class="legend-section" />
                <ui:Button name="legendCraftToggle" text="–" picking-mode="Position" class="legend-toggle legend-toggle--mini ui-btn-ghost" tooltip="Hide craft colours." />
            </ui:VisualElement>
            <ui:VisualElement name="legendCraft" class="legend-rows" picking-mode="Ignore" />
            <ui:VisualElement class="legend-section-head" picking-mode="Ignore">
                <ui:Label text="Scene" picking-mode="Ignore" class="legend-section" />
                <ui:Button name="legendSceneToggle" text="–" picking-mode="Position" class="legend-toggle legend-toggle--mini ui-btn-ghost" tooltip="Hide scene colours." />
            </ui:VisualElement>
            <ui:VisualElement name="legendScene" class="legend-rows" picking-mode="Ignore" />
            <ui:VisualElement name="legendCuesFold" class="legend-fold" picking-mode="Ignore">
                <ui:VisualElement class="legend-section-head" picking-mode="Ignore">
                    <ui:Label name="legendCuesTitle" text="Cues on now" picking-mode="Ignore" class="legend-section" />
                    <ui:Button name="legendCuesToggle" text="–" picking-mode="Position" class="legend-toggle legend-toggle--mini ui-btn-ghost" tooltip="Hide cue colours." />
                </ui:VisualElement>
                <ui:VisualElement name="legendCues" class="legend-rows" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="legendKeysHeader" class="legend-header legend-keys-header">
            <ui:Label text="Shortcuts" picking-mode="Ignore" class="legend-mode" />
            <ui:Button name="legendKeysToggleBtn" text="–" picking-mode="Position" class="legend-toggle ui-btn-ghost" tooltip="Hide keyboard shortcuts." />
        </ui:VisualElement>
        <ui:VisualElement name="legendKeys" class="legend-keys" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Instance template="Timeline" name="timelineInstance" picking-mode="Ignore" class="screen-overlay"/>
    <ui:VisualElement name="marqueeBox" picking-mode="Ignore" class="marquee-box" />
    <ui:VisualElement name="budgetHud" picking-mode="Ignore" class="budget-hud" />
</ui:UXML>
