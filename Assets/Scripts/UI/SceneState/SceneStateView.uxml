<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="SceneStateView.uss" />
    <ui:VisualElement name="sceneStateRoot" class="scene-state-root" picking-mode="Ignore">

        <ui:VisualElement name="aircraftPanel" picking-mode="Position" class="scene-state-panel scene-state-panel--aircraft">
            <ui:VisualElement name="aircraftHeaderBar" class="scene-state-header">
                <ui:VisualElement name="aircraftDragHandle" class="scene-state-drag">
                    <ui:Label text="Aircraft" picking-mode="Ignore" class="scene-state-title" />
                </ui:VisualElement>
                <ui:Button name="aircraftBeliefBtn" text="Color" picking-mode="Position" class="scene-state-header-btn" tooltip="Paint every craft as the selected observer declared it. Grey is undeclared. Scoring declarations, not radio contact. B also toggles." />
                <ui:Button name="aircraftCloseBtn" text="×" picking-mode="Position" class="scene-state-close" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-section-head" picking-mode="Ignore">
                <ui:Label name="aircraftHeader" text="Aircraft" picking-mode="Ignore" class="scene-state-section-title" />
                <ui:Label name="aircraftMix" text="" picking-mode="Ignore" class="scene-state-section-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-filters" picking-mode="Ignore">
                <ui:TextField name="aircraftFilter" placeholder-text="Filter…  Ctrl-click toggle, Shift-click range" class="scene-state-filter" />
                <ui:VisualElement name="aircraftKindChips" class="filter-chips" picking-mode="Ignore" />
                <ui:VisualElement name="aircraftStatusChips" class="filter-chips" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-cols">
                <ui:Button name="aircraftColName" text="Name" class="scene-state-col scene-state-col-name" />
                <ui:Button name="aircraftColKind" text="Kind" class="scene-state-col scene-state-col-ac-kind" />
                <ui:Button name="aircraftColCalled" text="Called" class="scene-state-col scene-state-col-called" />
                <ui:Button name="aircraftColSlot" text="Slot" class="scene-state-col scene-state-col-slot" />
                <ui:Button name="aircraftColSpeed" text="Speed" class="scene-state-col scene-state-col-speed" />
                <ui:Button name="aircraftColStatus" text="Status" class="scene-state-col scene-state-col-status" />
            </ui:VisualElement>
            <ui:ScrollView name="aircraftScroll" class="scene-state-table-scroll" />
        </ui:VisualElement>

        <ui:VisualElement name="eventsPanel" picking-mode="Position" class="scene-state-panel scene-state-panel--events">
            <ui:VisualElement name="eventsHeaderBar" class="scene-state-header">
                <ui:VisualElement name="eventsDragHandle" class="scene-state-drag">
                    <ui:Label text="Events" picking-mode="Ignore" class="scene-state-title" />
                </ui:VisualElement>
                <ui:Button name="eventsCloseBtn" text="×" picking-mode="Position" class="scene-state-close" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-section-head" picking-mode="Ignore">
                <ui:Label name="eventsHeader" text="Events" picking-mode="Ignore" class="scene-state-section-title" />
                <ui:Label text="click a row to jump one frame before" picking-mode="Ignore" class="scene-state-section-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-filters" picking-mode="Ignore">
                <ui:TextField name="eventsFilter" placeholder-text="Filter kind, text, drone…" class="scene-state-filter" />
                <ui:VisualElement name="eventKindChips" class="filter-chips" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-cols">
                <ui:Button name="eventsColTime" text="Time" class="scene-state-col scene-state-col-time" />
                <ui:Button name="eventsColKind" text="Kind" class="scene-state-col scene-state-col-kind" />
                <ui:Button name="eventsColSev" text="Sev" class="scene-state-col scene-state-col-sev" />
                <ui:Button name="eventsColWho" text="Involved" class="scene-state-col scene-state-col-who" />
                <ui:Button name="eventsColText" text="Text" class="scene-state-col scene-state-col-text" />
            </ui:VisualElement>
            <ui:ScrollView name="eventsScroll" class="scene-state-table-scroll" />
        </ui:VisualElement>

        <ui:VisualElement name="logsPanel" picking-mode="Position" class="scene-state-panel scene-state-panel--logs">
            <ui:VisualElement name="logsHeaderBar" class="scene-state-header">
                <ui:VisualElement name="logsDragHandle" class="scene-state-drag">
                    <ui:Label text="Logs" picking-mode="Ignore" class="scene-state-title" />
                </ui:VisualElement>
                <ui:Button name="logsRawBtn" text="Raw" picking-mode="Position" class="scene-state-header-btn" tooltip="Show exactly what the brain wrote instead of the plain-English reading." />
                <ui:Button name="logsCloseBtn" text="×" picking-mode="Position" class="scene-state-close" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-section-head" picking-mode="Ignore">
                <ui:Label name="logsHeader" text="Logs" picking-mode="Ignore" class="scene-state-section-title" />
                <ui:Label text="click a line to jump" picking-mode="Ignore" class="scene-state-section-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-filters" picking-mode="Ignore">
                <ui:TextField name="logsFilter" placeholder-text="Filter time, drone, text…" class="scene-state-filter" />
                <ui:VisualElement name="logVerbChips" class="filter-chips" picking-mode="Ignore" />
                <ui:VisualElement name="logDroneChips" class="filter-chips" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-cols">
                <ui:Button name="logsColTime" text="Time" class="scene-state-col scene-state-col-log-time" />
                <ui:Button name="logsColDrone" text="Drone" class="scene-state-col scene-state-col-log-drone" />
                <ui:Button name="logsColText" text="Text" class="scene-state-col scene-state-col-log-text" />
            </ui:VisualElement>
            <ui:ScrollView name="logsScroll" class="scene-state-table-scroll" />
        </ui:VisualElement>

        <ui:VisualElement name="cuesPanel" picking-mode="Position" class="scene-state-panel scene-state-panel--cues">
            <ui:VisualElement name="cuesHeaderBar" class="scene-state-header">
                <ui:VisualElement name="cuesDragHandle" class="scene-state-drag">
                    <ui:Label text="Cues" picking-mode="Ignore" class="scene-state-title" />
                </ui:VisualElement>
                <ui:Button name="cuesCloseBtn" text="×" picking-mode="Position" class="scene-state-close" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-section-head" picking-mode="Ignore">
                <ui:Label text="Overlays" picking-mode="Ignore" class="scene-state-section-title" />
                <ui:Label text="selected craft, unless noted" picking-mode="Ignore" class="scene-state-section-hint" />
            </ui:VisualElement>
            <ui:VisualElement name="cuesChipRow" class="filter-chips" picking-mode="Ignore" />
            <ui:ScrollView name="cuesDetailScroll" class="cue-detail-scroll">
                <ui:VisualElement name="cuesDetailHead" class="cue-detail-head" picking-mode="Ignore">
                    <ui:VisualElement name="cuesDetailSwatch" class="legend-swatch" picking-mode="Ignore" style="display: none;" />
                    <ui:Label name="cuesDetailTitle" text="" picking-mode="Ignore" class="cue-detail-title" />
                </ui:VisualElement>
                <ui:Label name="cuesDetailShape" text="" picking-mode="Ignore" class="cue-detail-body" />
                <ui:VisualElement name="cuesDetailKey" picking-mode="Ignore" />
                <ui:Label name="cuesDetailDraws" text="" picking-mode="Ignore" class="cue-detail-body" />
                <ui:Label name="cuesDetailSource" text="" picking-mode="Ignore" class="cue-detail-source" />
            </ui:ScrollView>
            <ui:Label name="cuesFooter" text="" picking-mode="Ignore" class="scene-state-section-hint scene-state-cue-footer" />
        </ui:VisualElement>

        <ui:VisualElement name="disagreePanel" picking-mode="Position" class="scene-state-panel scene-state-panel--disagree">
            <ui:VisualElement name="disagreeHeaderBar" class="scene-state-header">
                <ui:VisualElement name="disagreeDragHandle" class="scene-state-drag">
                    <ui:Label text="Disagree" picking-mode="Ignore" class="scene-state-title" />
                </ui:VisualElement>
                <ui:Button name="disagreeAgreeBtn" text="Agreements" picking-mode="Position" class="scene-state-header-btn" tooltip="Also list crafts where every caller agrees with the others and with ground truth, including fused radio calls." />
                <ui:Button name="disagreeCloseBtn" text="×" picking-mode="Position" class="scene-state-close" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-section-head" picking-mode="Ignore">
                <ui:Label name="disagreeHeader" text="Disagree" picking-mode="Ignore" class="scene-state-section-title" />
                <ui:Label name="disagreeMix" text="" picking-mode="Ignore" class="scene-state-section-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-filters" picking-mode="Ignore">
                <ui:TextField name="disagreeFilter" placeholder-text="Filter craft, calls…" class="scene-state-filter" />
            </ui:VisualElement>
            <ui:VisualElement class="scene-state-cols">
                <ui:Label text="Craft" picking-mode="Ignore" class="scene-state-col scene-state-col-name" />
                <ui:Label text="Truth" picking-mode="Ignore" class="scene-state-col scene-state-col-ac-kind" />
                <ui:Label text="Calls" picking-mode="Ignore" class="scene-state-col scene-state-col-called" />
                <ui:Label text="Why" picking-mode="Ignore" class="scene-state-col scene-state-col-status" />
            </ui:VisualElement>
            <ui:ScrollView name="disagreeScroll" class="scene-state-table-scroll" />
            <ui:Label name="disagreeDetailTitle" text="Click a row for every call on that craft" picking-mode="Ignore" class="scene-state-section-hint" />
            <ui:ScrollView name="disagreeDetailScroll" class="disagree-detail-scroll" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
