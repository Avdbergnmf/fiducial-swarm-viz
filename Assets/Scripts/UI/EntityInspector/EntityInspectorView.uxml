<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="EntityInspectorView.uss" />
    <ui:Style src="../SceneState/SceneStateView.uss" />
    <ui:VisualElement name="inspectorRoot" class="inspector-root" picking-mode="Ignore">
        <ui:VisualElement name="inspectorPanel" picking-mode="Position" class="inspector-panel">
            <ui:VisualElement name="inspectorHeader" class="inspector-header">
                <ui:VisualElement name="inspectorDragHandle" class="inspector-drag">
                    <ui:VisualElement name="inspectorKindDot" picking-mode="Ignore" class="inspector-kind-dot" />
                    <ui:Label name="inspectorTitle" text="—" picking-mode="Ignore" class="inspector-title" />
                </ui:VisualElement>
                <ui:Button name="inspectorBeliefsBtn" text="Beliefs" picking-mode="Position" class="inspector-header-btn" tooltip="Pin this drone's beliefs. Stays open if you pick someone else." />
                <ui:Button name="inspectorCloseBtn" text="×" picking-mode="Position" class="inspector-close" />
            </ui:VisualElement>
            <ui:Label name="inspectorSubtitle" text="" picking-mode="Ignore" class="inspector-subtitle" />
            <ui:ScrollView name="inspectorBody" class="inspector-body">
            <ui:Label text="Now" picking-mode="Ignore" class="inspector-section-title" />
            <ui:VisualElement class="inspector-facts" picking-mode="Ignore">
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Status" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorStatus" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Speed" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorSpeed" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Accel" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorAccel" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Altitude" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorAltitude" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Ground (x, z)" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorPosition" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Heading" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorHeading" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="Identity" picking-mode="Ignore" class="inspector-section-title" />
            <ui:VisualElement class="inspector-facts" picking-mode="Ignore">
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Kind" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorKind" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Slot" picking-mode="Ignore" class="inspector-key" tooltip="Viewer column in the recording, 0-based. Equals drone id for the initial fleet." />
                    <ui:Label name="inspectorSlot" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Trace id" picking-mode="Ignore" class="inspector-key" tooltip="Simulator entity id, 1-based. Drone 0 is sim #1. This is the number that used to appear in event text, one higher than the log column." />
                    <ui:Label name="inspectorTrace" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Drone id" picking-mode="Ignore" class="inspector-key" tooltip="Brain id, 0-based. Same number as the Logs column and as Drone N in the aircraft list." />
                    <ui:Label name="inspectorDrone" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Lifetime" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorLifetime" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Kill radius" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorKillRadius" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Sense" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorSense" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Comm" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorComm" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Sep margin" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorSep" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
                <ui:VisualElement name="inspectorCompromisedRow" class="inspector-row" picking-mode="Ignore">
                    <ui:Label text="Compromised" picking-mode="Ignore" class="inspector-key" />
                    <ui:Label name="inspectorCompromised" text="—" picking-mode="Ignore" class="inspector-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="inspector-section" picking-mode="Ignore">
                <ui:VisualElement class="inspector-section-head" picking-mode="Ignore">
                    <ui:Label name="inspectorEventsHeader" text="Events" picking-mode="Ignore" class="inspector-section-title inspector-section-title--inline" />
                    <ui:Label text="click to jump one frame before" picking-mode="Ignore" class="inspector-section-hint" />
                </ui:VisualElement>
                <ui:ScrollView name="inspectorEventsScroll" class="inspector-scroll inspector-scroll--events" />
            </ui:VisualElement>

            <ui:VisualElement name="inspectorLogSection" class="inspector-section" picking-mode="Ignore">
                <ui:VisualElement class="inspector-section-head" picking-mode="Ignore">
                    <ui:VisualElement class="inspector-section-head-lead" picking-mode="Ignore">
                        <ui:Label name="inspectorLogHeader" text="Log" picking-mode="Ignore" class="inspector-section-title inspector-section-title--inline" />
                        <ui:Label text="click to jump" picking-mode="Ignore" class="inspector-section-hint" />
                    </ui:VisualElement>
                    <ui:Button name="inspectorLogRawBtn" text="Raw" picking-mode="Position" class="inspector-header-btn" tooltip="Show exactly what the brain wrote instead of the plain-English reading." />
                </ui:VisualElement>
                <ui:VisualElement name="inspectorLogVerbs" class="filter-chips" picking-mode="Ignore" />
                <ui:ScrollView name="inspectorLogScroll" class="inspector-scroll inspector-scroll--log" />
            </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="beliefsPanel" picking-mode="Position" class="inspector-panel inspector-panel--beliefs">
            <ui:VisualElement name="beliefsHeader" class="inspector-header">
                <ui:VisualElement name="beliefsDragHandle" class="inspector-drag">
                    <ui:VisualElement name="beliefsKindDot" picking-mode="Ignore" class="inspector-kind-dot" />
                    <ui:Label name="beliefsTitle" text="Beliefs" picking-mode="Ignore" class="inspector-title" />
                </ui:VisualElement>
                <ui:Button name="beliefsSelectBtn" text="Select" picking-mode="Position" class="inspector-header-btn" tooltip="Select this drone in the scene. Recovers it if you clicked away." />
                <ui:Button name="beliefsCloseBtn" text="×" picking-mode="Position" class="inspector-close" />
            </ui:VisualElement>
            <ui:Label name="beliefsSubtitle" text="" picking-mode="Ignore" class="inspector-subtitle" />
            <ui:Button name="beliefsVizBtn" text="Color scene" picking-mode="Position" class="inspector-toggle" tooltip="Paint every craft as this drone declared it. Grey is undeclared. Declarations are a scoring hook, not radio contact. B also toggles." />
            <ui:ScrollView name="beliefsBody" class="inspector-body">
                <ui:VisualElement class="inspector-section-head" picking-mode="Ignore">
                    <ui:Label text="Stance" picking-mode="Ignore" class="inspector-section-title inspector-section-title--inline" />
                    <ui:Label text="what it is doing with itself" picking-mode="Ignore" class="inspector-section-hint" />
                </ui:VisualElement>
                <ui:Label name="beliefsIntent" text="—" picking-mode="Ignore" class="inspector-value inspector-value--wrap inspector-intent" />

                <ui:VisualElement class="inspector-section" picking-mode="Ignore">
                    <ui:VisualElement class="inspector-section-head" picking-mode="Ignore">
                        <ui:Label name="beliefsCallsHeader" text="Calls on this craft" picking-mode="Ignore" class="inspector-section-title inspector-section-title--inline" />
                        <ui:Label name="beliefsCallsHint" text="who called it / actual" picking-mode="Ignore" class="inspector-section-hint" />
                    </ui:VisualElement>
                    <ui:Label text="Other drones' scoring calls about this craft. Each row is another brain's declare_track — a note to the simulator, not a radio message. Unknown is omitted. Click a caller to select them." picking-mode="Ignore" class="inspector-blurb" />
                    <ui:VisualElement class="inspector-belief-cols" picking-mode="Ignore">
                        <ui:Label text="Who" picking-mode="Ignore" class="inspector-belief-col inspector-belief-col--name" />
                        <ui:Label text="Called" picking-mode="Ignore" class="inspector-belief-col inspector-belief-col--called" />
                        <ui:Label text="Actual" picking-mode="Ignore" class="inspector-belief-col inspector-belief-col--actual" />
                    </ui:VisualElement>
                    <ui:ScrollView name="beliefsCallsScroll" class="inspector-scroll" />
                </ui:VisualElement>

                <ui:VisualElement class="inspector-section" picking-mode="Ignore">
                    <ui:VisualElement class="inspector-section-head" picking-mode="Ignore">
                        <ui:Label name="beliefsSeesHeader" text="What it has declared" picking-mode="Ignore" class="inspector-section-title inspector-section-title--inline" />
                        <ui:Label text="click a row to select" picking-mode="Ignore" class="inspector-section-hint" />
                    </ui:VisualElement>
                    <ui:Label text="This brain's current scoring calls. Color scene paints the world from this list. Not who is on the radio (that is the Radio links cue) and not every track it can sense — unknown stays off the list. This brain only declares hostiles, so silence is 'not yet called', not 'friendly'." picking-mode="Ignore" class="inspector-blurb" />
                    <ui:VisualElement class="inspector-belief-cols" picking-mode="Ignore">
                        <ui:Label text="Craft" picking-mode="Ignore" class="inspector-belief-col inspector-belief-col--name" />
                        <ui:Label text="Called" picking-mode="Ignore" class="inspector-belief-col inspector-belief-col--called" />
                        <ui:Label text="Actual" picking-mode="Ignore" class="inspector-belief-col inspector-belief-col--actual" />
                    </ui:VisualElement>
                    <ui:ScrollView name="beliefsSeesScroll" class="inspector-scroll" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
