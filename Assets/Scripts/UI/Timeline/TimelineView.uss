.timeline-root {
    position: absolute;
    bottom: 16px;
    left: 24px;
    right: 24px;
    width: auto;
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 20, 24, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    overflow: visible;
}

.timeline-button {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(235, 235, 235);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-right: 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.timeline-button:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-left-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.timeline-button:active {
    background-color: rgba(70, 130, 240, 0.5);
}

.track-container {
    flex-grow: 1;
    height: 28px;
    justify-content: center;
    margin-left: 10px;
    margin-right: 14px;
    position: relative;
}

.track-background {
    position: absolute;
    left: 0;
    right: 0;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.track-fill {
    position: absolute;
    left: 0;
    width: 0%;
    height: 8px;
    background-color: rgb(65, 140, 245);
    border-top-left-radius: 4px;
    border-top-right-radius: 0;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 0;
}

.track-score-marks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.track-playhead {
    position: absolute;
    left: 0%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    top: 7px;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.track-tooltip {
    position: absolute;
    bottom: 30px;
    left: 0%;
    background-color: rgba(10, 12, 16, 0.95);
    color: rgb(240, 240, 240);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 11px;
    display: none;
}

.time-label {
    color: rgb(220, 220, 220);
    font-size: 13px;
    margin-right: 12px;
    min-width: 110px;
    -unity-text-align: middle-center;
}

.speed-button {
    min-width: 44px;
    margin-right: 0;
}

.timeline-flyout-host {
    position: relative;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    margin-right: 6px;
    overflow: visible;
}

#speedHost {
    margin-right: 0;
}

.timeline-step-row {
    flex-direction: row;
    align-items: center;
}

.timeline-step-row .timeline-button {
    margin-right: 6px;
}

.timeline-step-end {
    margin-right: 0;
}

.timeline-flyout {
    position: absolute;
    bottom: 100%;
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 8px;
    margin-bottom: 0;
    background-color: rgba(18, 20, 24, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.16);
    border-right-color: rgba(255, 255, 255, 0.16);
    border-top-color: rgba(255, 255, 255, 0.16);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    display: none;
}

.timeline-flyout--start {
    left: 0;
}

.timeline-flyout--end {
    right: 0;
}

.timeline-flyout-btn {
    min-width: 42px;
    margin-right: 4px;
    margin-bottom: 0;
    white-space: nowrap;
}

.timeline-flyout-btn--end {
    margin-right: 0;
}

.timeline-flyout-btn.timeline-flyout-btn--on {
    background-color: rgba(65, 140, 245, 0.55);
    border-left-color: rgba(65, 140, 245, 0.9);
    border-right-color: rgba(65, 140, 245, 0.9);
    border-top-color: rgba(65, 140, 245, 0.9);
    border-bottom-color: rgba(65, 140, 245, 0.9);
}
