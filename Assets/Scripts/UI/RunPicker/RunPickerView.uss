/*
2026-08-30 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.run-picker-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.run-picker-toggle-btn {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: rgba(22, 25, 30, 0.85);
    color: rgb(230, 230, 230);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 12px;
}

.run-picker-toggle-btn:hover {
    background-color: rgba(35, 40, 50, 0.95);
    border-left-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.picker-dialog {
    width: 780px;
    min-height: 520px;
    position: relative;
    background-color: rgb(24, 28, 34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-top-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.dialog-title {
    color: rgb(245, 245, 245);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.picker-body {
    flex-direction: row;
    height: 300px;
    margin-bottom: 12px;
}

.run-list-scroll {
    width: 300px;
    flex-shrink: 0;
    height: 100%;
    background-color: rgb(15, 17, 21);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.run-preview {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 12px;
    background-color: rgb(15, 17, 21);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.preview-title {
    color: rgb(245, 245, 245);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    white-space: normal;
}

.preview-scroll {
    flex-grow: 1;
    min-height: 0;
}

.preview-section {
    color: rgb(130, 138, 148);
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 2px;
}

.preview-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 2px;
    padding-bottom: 2px;
}

.preview-key {
    color: rgb(140, 146, 154);
    font-size: 11px;
    width: 108px;
    flex-shrink: 0;
}

.preview-value {
    color: rgb(230, 230, 230);
    font-size: 11px;
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: upper-right;
    white-space: normal;
}

.preview-unknown {
    color: rgb(110, 116, 124);
    -unity-font-style: italic;
}

.run-item {
    flex-direction: row;
    justify-content: space-between;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.run-item:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.run-item-selected {
    background-color: rgba(65, 140, 245, 0.25);
    border-left-width: 3px;
    border-left-color: rgb(65, 140, 245);
}

.run-item-name {
    color: rgb(240, 240, 240);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 1;
}

.run-item-meta {
    color: rgb(160, 160, 160);
    font-size: 11px;
    flex-shrink: 0;
    margin-left: 8px;
}

.path-input-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.path-input-field {
    flex-grow: 1;
    min-width: 0;
    font-size: 12px;
}

/* Inner input is what the caret and glyphs sit on; the outer field's color/background do not. */
.path-input-field .unity-base-text-field__input {
    background-color: rgb(15, 17, 21);
    color: rgb(240, 240, 240);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.path-input-field .unity-text-element {
    color: rgb(240, 240, 240);
}

.browse-folder-btn {
    flex-shrink: 0;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(200, 200, 200);
    font-size: 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.browse-folder-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.run-list-source {
    color: rgb(130, 138, 148);
    font-size: 10px;
    -unity-font-style: bold;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 2px;
}

.error-label {
    color: rgb(255, 90, 80);
    font-size: 11px;
    margin-bottom: 10px;
    min-height: 16px;
    white-space: normal;
    overflow: hidden;
}

.dialog-button-row {
    flex-direction: row;
    align-items: center;
}

.dialog-button-spacer {
    flex-grow: 1;
}

.dialog-btn {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 12px;
    margin-left: 8px;
}

.btn-cancel {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(200, 200, 200);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.btn-cancel:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border-left-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.btn-load {
    background-color: rgb(45, 120, 230);
    color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(75, 150, 255);
    border-right-color: rgb(75, 150, 255);
    border-top-color: rgb(75, 150, 255);
    border-bottom-color: rgb(75, 150, 255);
    -unity-font-style: bold;
}

.btn-load:hover {
    background-color: rgb(70, 145, 245);
}

.btn-validate {
    background-color: rgba(230, 180, 70, 0.18);
    color: rgb(240, 210, 130);
    margin-left: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(230, 180, 70, 0.45);
    border-right-color: rgba(230, 180, 70, 0.45);
    border-top-color: rgba(230, 180, 70, 0.45);
    border-bottom-color: rgba(230, 180, 70, 0.45);
}

.btn-validate:hover {
    background-color: rgba(230, 180, 70, 0.3);
}

.preview-issue {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 3px;
    padding-bottom: 3px;
}

.preview-issue-tag {
    font-size: 10px;
    -unity-font-style: bold;
    width: 18px;
    flex-shrink: 0;
    margin-right: 4px;
}

.preview-issue-check {
    font-size: 11px;
    width: 90px;
    flex-shrink: 0;
    color: rgb(200, 200, 200);
}

.preview-issue-msg {
    font-size: 11px;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(180, 180, 180);
}

.preview-issue--error .preview-issue-tag { color: rgb(255, 90, 80); }
.preview-issue--warning .preview-issue-tag { color: rgb(230, 180, 70); }
.preview-issue--info .preview-issue-tag { color: rgb(140, 146, 154); }
.preview-pass {
    color: rgb(90, 190, 120);
    font-size: 11px;
    margin-top: 2px;
}
.preview-fail {
    color: rgb(255, 90, 80);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}
.preview-warn {
    color: rgb(230, 180, 70);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}
.preview-note {
    color: rgb(110, 116, 124);
    font-size: 11px;
    -unity-font-style: italic;
    margin-top: 2px;
    white-space: normal;
}

.report-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
    background-color: rgb(24, 28, 34);
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.report-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.report-title {
    margin-bottom: 0;
    flex-grow: 1;
}

.report-summary {
    color: rgb(210, 210, 210);
    font-size: 12px;
    margin-bottom: 10px;
    white-space: normal;
    flex-shrink: 0;
}

.report-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(15, 17, 21);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.report-row {
    flex-direction: column;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.report-row-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.report-status {
    width: 52px;
    flex-shrink: 0;
    font-size: 11px;
    -unity-font-style: bold;
}

.report-check {
    color: rgb(240, 240, 240);
    font-size: 12px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.report-params {
    color: rgb(130, 138, 148);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 2px;
}

.report-msg {
    color: rgb(200, 200, 200);
    font-size: 12px;
    white-space: normal;
}

.report-row--pass .report-status { color: rgb(90, 190, 120); }
.report-row--warning .report-status { color: rgb(230, 180, 70); }
.report-row--error .report-status { color: rgb(255, 90, 80); }
.report-row--info .report-status { color: rgb(140, 146, 154); }
