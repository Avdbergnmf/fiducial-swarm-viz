This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.run-picker-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.run-picker-toggle-btn {
    position: absolute;
    top: 14px;
    left: 14px;
    background-color: rgba(22, 25, 30, 0.85);
    color: rgb(230, 230, 230);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 12px;
}

.run-picker-toggle-btn:hover {
    background-color: rgba(35, 40, 50, 0.95);
    border-left-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.picker-dialog {
    width: 520px;
    background-color: rgb(24, 28, 34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-top-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.dialog-title {
    color: rgb(245, 245, 245);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.run-list-scroll {
    height: 200px;
    background-color: rgb(15, 17, 21);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-color: rgba(255, 255, 255, 0.1);
    border-top-color: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-bottom: 12px;
    overflow: hidden;
}

.run-item {
    flex-direction: row;
    justify-content: space-between;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.run-item:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.run-item-selected {
    background-color: rgba(65, 140, 245, 0.25);
    border-left-width: 3px;
    border-left-color: rgb(65, 140, 245);
}

.run-item-name {
    color: rgb(240, 240, 240);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 1;
}

.run-item-meta {
    color: rgb(160, 160, 160);
    font-size: 11px;
    flex-shrink: 0;
    margin-left: 8px;
}

.path-input-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    picking-mode: ignore;
}

.path-input-field {
    flex-grow: 1;
    min-width: 0;
    font-size: 12px;
}

/* Inner input is what the caret and glyphs sit on; the outer field's color/background do not. */
.path-input-field .unity-base-text-field__input {
    background-color: rgb(15, 17, 21);
    color: rgb(240, 240, 240);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.path-input-field .unity-text-element {
    color: rgb(240, 240, 240);
}

.browse-folder-btn {
    flex-shrink: 0;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(200, 200, 200);
    font-size: 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.browse-folder-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.run-list-source {
    color: rgb(130, 138, 148);
    font-size: 10px;
    -unity-font-style: bold;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 2px;
}

.error-label {
    color: rgb(255, 90, 80);
    font-size: 11px;
    margin-bottom: 10px;
    min-height: 16px;
    white-space: normal;
    overflow: hidden;
    picking-mode: ignore;
}

.dialog-button-row {
    flex-direction: row;
    justify-content: flex-end;
}

.dialog-btn {
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 12px;
    margin-left: 8px;
}

.btn-cancel {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(200, 200, 200);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
}

.btn-cancel:hover {
    background-color: rgba(255, 255, 255, 0.16);
    border-left-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
}

.btn-load {
    background-color: rgb(45, 120, 230);
    color: rgb(255, 255, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(75, 150, 255);
    border-right-color: rgb(75, 150, 255);
    border-top-color: rgb(75, 150, 255);
    border-bottom-color: rgb(75, 150, 255);
    -unity-font-style: bold;
}

.btn-load:hover {
    background-color: rgb(70, 145, 245);
}
